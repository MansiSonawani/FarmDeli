# Copy this file to .env for local development.
#
# true  = demo mode: no backend, resumes are saved in your browser (just run `npm run dev`).
# false = use the real API: run `npm run dev:server` in a second terminal. Without DATABASE_URL
#         it uses an in-memory Postgres (PGlite), so data resets when the server restarts.
VITE_DEMO_MODE=true

# Server only (never exposed to the browser). On Railway these are service variables.
# DATABASE_URL=postgresql://user:password@host:5432/db
# ANTHROPIC_API_KEY=
